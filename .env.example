# Copy to .env and fill in. .env is git-ignored; never commit keys.
# Any OpenAI-compatible endpoint works. Model ids change over time: check your provider's model list.

# Option A: Groq free tier (fast, rate-limited)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-key-here
LLM_MODEL=llama-3.3-70b-versatile

# Option B: OpenRouter (pick a free open-weight model from openrouter.ai/models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your-key-here
# LLM_MODEL=<model id>

# Option C: Ollama on your machine or in Colab (no key, slower)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct

# Ask for JSON-mode responses (set 0 if your provider rejects response_format)
LLM_JSON_MODE=1
# Seconds between calls, to stay under free-tier rate limits
LLM_MIN_INTERVAL_S=0

# Reproduce results from the committed cache only; never call the network
# AUTHAGENT_OFFLINE=1

# Local verifier: auto | finetuned | nli | lexical
AUTHAGENT_VERIFIER=auto
# Set to 1 to skip dense retrieval (BM25 only)
# AUTHAGENT_NO_DENSE=1
